# ── Required ──────────────────────────────────────────────────────────────────
# Anthropic API key. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional overrides ────────────────────────────────────────────────────────
# LLM model to use. Defaults to claude-sonnet-4-6.
# CHAINWATCH_MODEL=claude-sonnet-4-6

# Token budget per file chunk sent to the LLM. Reduce if hitting context limits.
# CHAINWATCH_MAX_TOKENS_PER_CHUNK=8000

# HTTP request timeout in seconds for registry and feed API calls.
# CHAINWATCH_HTTP_TIMEOUT=30

# Number of retry attempts on rate-limited or transient API failures.
# CHAINWATCH_MAX_RETRIES=3

# Registry base URLs — override for testing against mirrors or proxies.
# CHAINWATCH_NPM_REGISTRY=https://registry.npmjs.org
# CHAINWATCH_PYPI_REGISTRY=https://pypi.org/pypi

# Feed API base URLs
# CHAINWATCH_OSV_API=https://api.osv.dev/v1
# CHAINWATCH_REKOR_API=https://rekor.sigstore.dev
# CHAINWATCH_SCORECARD_API=https://api.securityscorecards.dev
