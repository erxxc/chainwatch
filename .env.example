# chainwatch configuration
# Copy to .env and fill in values

# Required: Anthropic API key for LLM analysis
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override defaults
# CHAINWATCH_MODEL=claude-sonnet-4-6
# CHAINWATCH_MAX_TOKENS_PER_CHUNK=8000
# CHAINWATCH_MAX_RESPONSE_TOKENS=4096
# CHAINWATCH_HTTP_TIMEOUT=30.0
# CHAINWATCH_MAX_RETRIES=3
# CHAINWATCH_MAX_CONCURRENT_LLM_CHUNKS=4
# CHAINWATCH_MAX_CONCURRENT_SCAN_DEPS=3

# Optional: safety limits for hostile package archives
# CHAINWATCH_MAX_DOWNLOAD_BYTES=104857600
# CHAINWATCH_MAX_EXTRACTED_BYTES=524288000
# CHAINWATCH_MAX_ARCHIVE_FILES=25000
# CHAINWATCH_MAX_ARCHIVE_FILE_BYTES=52428800
# CHAINWATCH_MAX_DIFF_FILE_BYTES=2097152
# CHAINWATCH_ALLOWED_ARCHIVE_HOSTS=artifacts.example.com,cdn.example.com

# Optional: override registry/API URLs (for testing or mirrors)
# CHAINWATCH_NPM_REGISTRY=https://registry.npmjs.org
# CHAINWATCH_PYPI_REGISTRY=https://pypi.org/pypi
# CHAINWATCH_OSV_API=https://api.osv.dev/v1
# CHAINWATCH_REKOR_API=https://rekor.sigstore.dev
# CHAINWATCH_SCORECARD_API=https://api.securityscorecards.dev
