# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
ENV/

# Offline install artifacts (kept local; commit a lockfile instead)
wheelhouse/
.pip-cache/

# uv.lock and .python-version are committed on purpose. Do not list them here:
# gitignore has no trailing-comment syntax, so a line like
# 'uv.lock  # committed' silently matches nothing.

# Environment / secrets — NEVER commit .env
.env

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Type checking
.mypy_cache/
.ruff_cache/

# Temp directories created during diff analysis
/tmp/chainwatch-*
chainwatch-from-*
chainwatch-to-*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Dataset tarballs — preserved by hash; actual .tgz files not committed
dataset/malicious/**/*.tgz
dataset/malicious/**/*.tar.gz
dataset/benign/**/*.tgz
dataset/benign/**/*.tar.gz
