.pytest_cache/
.coverage
htmlcov/

# Type checking
.mypy_cache/
.ruff_cache/

# Temp directories created during diff analysis
/tmp/chainwatch-*
chainwatch-from-*
chainwatch-to-*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Dataset tarballs — preserved by hash; actual .tgz files not committed
dataset/malicious/**/*.tgz
dataset/malicious/**/*.tar.gz
dataset/benign/**/*.tgz
dataset/benign/**/*.tar.gz
